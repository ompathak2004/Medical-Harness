# --- Required ---
# Cerebras inference API key — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# MediSearch API key — https://medisearch.io/developers
MEDISEARCH_API_KEY=

# --- Optional (defaults shown) ---
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
PORT=8080
LOG_LEVEL=INFO
# Comma-separated origins, or * for all
CORS_ORIGINS=*
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
