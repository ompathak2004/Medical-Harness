# --- Required ---
# Cerebras inference API key — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# MediSearch API key — https://medisearch.io/developers
MEDISEARCH_API_KEY=

# --- Optional (defaults shown) ---
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# Optional Cerebras prompt_cache_key (routes requests to one cache shard;
# requires the feature enabled on your Cerebras account). Empty = omitted.
CEREBRAS_PROMPT_CACHE_KEY=
# Answer-prompt token budgets
MAX_EVIDENCE_ARTICLES=8
MAX_TLDR_CHARS=400
MAX_SUMMARY_CHARS=1500
# In-process result caches (TTL + LRU)
EVIDENCE_CACHE_ENTRIES=256
EVIDENCE_CACHE_TTL_SECONDS=3600
STEP_CACHE_ENTRIES=512
STEP_CACHE_TTL_SECONDS=600
PORT=8080
LOG_LEVEL=INFO
# Comma-separated origins, or * for all
CORS_ORIGINS=
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
