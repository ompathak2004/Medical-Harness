{
  "__inputs": [
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "title": "Medical Harness operations",
  "uid": "medical-harness-operations",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p95 time to reviewed answer",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{resource.service.name = \"medical-harness\" && kind = server && span.medical_harness.outcome = \"answer\"} | quantile_over_time(duration, 0.95)",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sampled application outcomes",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{resource.service.name = \"medical-harness\" && kind = server && span.http.route =~ \"/api/chat.*\"} | count_over_time() by (span.medical_harness.outcome)",
          "legendFormat": "{{span.medical_harness.outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reported model tokens",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{resource.service.name = \"medical-harness\" && name = \"provider.cerebras\"} | sum_over_time(span.gen_ai.usage.input_tokens)",
          "legendFormat": "Input"
        },
        {
          "refId": "B",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{resource.service.name = \"medical-harness\" && name = \"provider.cerebras\"} | sum_over_time(span.gen_ai.usage.output_tokens)",
          "legendFormat": "Output"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Estimated model spend (USD)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{resource.service.name = \"medical-harness\" && name = \"provider.cerebras\"} | sum_over_time(span.medical_harness.estimated_cost_usd)",
          "legendFormat": "Estimated USD"
        }
      ]
    }
  ]
}
